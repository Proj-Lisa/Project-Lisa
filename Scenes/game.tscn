[sub_resource type="GDScript" id="GDScript_ebmjs"]
script/source = "extends CharacterBody2D

# horizontal movement
const ACCEL_MAIN = 20	#was 50
const ACCEL_AIR = 12	#less control in the air
const ACCEL_JUMP = -120
const MIN_SPEED_AFTER_TURN = 90 #jumpstart to get out of lazy/ice-sliding turns
const FLOOR_SNAP = 20	#snaps Mona to the floor; disabled while jumping

#speed thresholds
const SPEED_MAX = 800
const SPEED_3 = 700
const SPEED_THAT_RAMPS = 450
const SPEED_THAT_BRAKES = 300
const SPEED_2 = 240
const SLOW_TO_MAX = ACCEL_MAIN + 1 			#must be greater than base movement to slow down
const SLOW_FROM_DASH = SLOW_TO_MAX * 1.25	#faster after a dash to compensate
#speed boost from orbs is defined in orb.gd

#jump and gravity values
const JUMP_VELOCITY = -600	#negative y goes up
const JUMP_VELOCITY_SHORT = -400
const MAX_JUMP = 520
const GRAVITY_FACTOR = 1.8	#increases gravity for faster-fall responsiveness
const GRAVITY_ONGROUND = 50
var stickToGround = true
var disableJump = false		#used to prevent jumping while in the air and other states

#jump variants
const HIGH_JUMP_X_PENALTY = 60 #move-toward-0 increment
const LONG_JUMP_Y_PENALTY = 200
var jumpBoost = 0			#both based on percent of maxSpeed achieved, in the moment
const MAX_JUMP_BOOST = 980	#decreased vertical by HIGH_JUMP_FRACTION
const MIN_SPEED_FOR_LONG_JUMP = 5
const HIGH_JUMP_FRACTION = 0.75	#proportion of vertical jumpBoost applied during High Jump
const PERFECT_JUMP_MIN = 16		#next 2 used for High and Long Jumps
const PERFECT_JUMP_MAX = 26		#eg, range in which Mona has MAX_JUMP_BOOST
const BOOST_RATE_EARLY = 50		#ramp to max
const BOOST_RATE_DECLINE = 30	#move to 0
#\\/deprecated, but will error out if commented out yet
const JUMP_BOOST_FACTOR = 30#multiplies the timer by this # for the variable boost figure
const HIGH_JUMP_BOOST = 2	#flat figure multiplied by JUMP_BOOST_FACTOR

#Mona hangs in the air if jump is held ever so slightly
const HANGTIME_WINDOW = 10
const HANGTIME_SPEED = 0.12
var hangtime = 1 #normally no effect on velocity, but use a move_toward 0 while holding Jump, release to reset
var hangtimeStart = false

const DECEL = 80				#used to slow down
const DECEL_SLIDE = 16			#for isAbrupt
var goingUp = true		#vertical direction, fall or jump animation
var smoothingTimer = 0	#prevents flashing of fall sprite when running over little bumps
const SMOOTHING_RUN_MARGIN = 4

var isAbruptStop = false #used for brake conditional and faster turn
var brakeTimer = 0		#used to lock braking
const END_BRAKING = 10	#frames braking locks Mona

#slide controls
var isSliding = false
var slideTimer = 0			 #used for raising jumpBoost
const SLIDE_SPEED = 10		 #not a multiplier but a rate moving to 0 like DECEL
const SLIDE_UNDER_BOOST = 10 #prevents standing underneath slide-unders

#dive controls
var diveSpeed = 1
var isDiving = false
const DIVE_SPEED = 1.7

#dash controls
var isDashing = false
var dashDisabled = false
var dashCooldownTimer = 0
var dashTimer = 0
const DASH_SPEED = 300 #flat add
const DASH_LENGTH = 30 #for animation to prioritize over running
const DASH_COOLDOWN_MAX = 50

#wallJump controls
var onWall = false
var onWallTimer = 0			#program to affect X and Y (inverse) proportionately
var disableHoriz = false
var disableHorizTimer = 0
var jumpDirectionRight = false
const DISABLE_HORIZ_TIMER_MAX = 12 #disables horizontal air movement to not counter the reverse motion
const ON_WALL_DRAG = .75
const WALL_JUMP_X = 600
const WALL_JUMP_Y = -700

#contextual functions
var isTaunting = false #when not moving
var canVault = false
var slopeVelocityAdjustment = 0
const SLOPE_MULTIPLIER = 2.8

#collision adjustments for animation
@onready var COL_BASE_pX = 3
@onready var COL_BASE_pY = -25 #hard-coded based on manual cursor adjustments in frame
@onready var COL_BASE_s = 1
const colDashPY = -15
const colSlidePY = -15
const ColSlideSY = 0.5

#Mona's Sprites and Collision RayCasts
@onready var monaSprite = $MonaSprite2D		#for animations
@onready var monaCollisionTop = $CollisionTop
@onready var MonaCollisionBot = $CollisionBot
const SPRITE_ROTATION_SPEED_GROUND = 17
const SPRITE_ROTATION_SPEED_AIR = 30
const MIN_SPEED_TO_ROTATE = 60

@onready var checkCeiling = $\"RayCast-Ceiling\"	#to disableJump when hitting a ceiling
@onready var checkWallRight = $\"RayCast-WallRight\"
@onready var checkWallLeft = $\"RayCast-WallLeft\"
@onready var checkSlopeRight = $\"RayCast-SlopeRight\"
@onready var checkSlopeLeft = $\"RayCast-SlopeLeft\"

#screen wrap + camera settings
@onready var wrapLeftSeam = $\"../Ground/WrapperLeft\" #for screenwrapping
@onready var wrapRightSeam = $\"../Ground/WrapperRight\"
@onready var cameraMona = $CameraMona
const CAMERA_LAG_MAX = 75		#increase to teens once refined the camera adjustment rates
const CAMERA_LAG_DECREASE = -3
var cameraLagTimer = 0
const CAMERA_MAX_X_OFFSET: float = 250.00	 #float declarations avoid a division error later
const CAMERA_X_OFFSET_FACTOR: float = 200.00 #divides current velocity to scale the variable below
const CAMERA_RESET_SPEED = 6
var cameraXOffsetSpeed = 0
var cameraOffsetAccel: float = 1.00		#used for exponential slowdown towards Offset 0 and max
const CAMERA_MAX_ZOOM_IN = 2.5
const CAMERA_MAX_ZOOM_OUT = 1.4
const CAMERA_ZOOM_IN = .04
const CAMERA_ZOOM_OUT = -.015
const CAMERA_ZOOM_TIME = 200
var cameraZoom = CAMERA_MAX_ZOOM_IN
var cameraZoomTimer = 0

#create camera Zoom and xOffset based on speed
#also need hair at some point, so may as well program the vector fn and base it on that

func _physics_process(delta: float) -> void:
	#set default snap2ground height
	floor_snap_length = FLOOR_SNAP
	var isOnFloor = is_on_floor() #currently just for checking slope adjustments; replace all of these funcs?
	
	# Add the gravity.
	if not isOnFloor:
		#check if diving: sliding in air
		if Input.is_action_pressed(\"slide\"):
			isDiving = true
			diveSpeed = DIVE_SPEED
			monaCollisionTop.set_deferred(\"disabled\", true)
		else:
			isDiving = false
			diveSpeed = 1 #reset to base
			monaCollisionTop.set_deferred(\"disabled\", false)
		
		#fall, and more slowly if on a wall
		if checkWallLeft.is_colliding() or checkWallRight.is_colliding():
			onWall = true
			onWallTimer += 1
			#print(onWallTimer)
			velocity += get_gravity() * delta * GRAVITY_FACTOR * hangtime * diveSpeed * ON_WALL_DRAG
		else:
			onWall = false
			onWallTimer = 0
			velocity += get_gravity() * delta * GRAVITY_FACTOR * hangtime * diveSpeed
	
	# Get input direction: -1, 0, 1
	var direction := Input.get_axis(\"move_Left\", \"move_Right\")
	
	#rotate the sprite to match terrain angle, but not while standing still
	var floorNormal = get_floor_normal()
	var spriteRotation = floorNormal.angle() + PI / 2
	if isOnFloor:
		if abs(velocity.x) > MIN_SPEED_TO_ROTATE:
			monaSprite.rotation = lerp_angle(monaSprite.rotation, spriteRotation, SPRITE_ROTATION_SPEED_GROUND * delta)
		else:
			monaSprite.rotation = lerp_angle(monaSprite.rotation, 0, SPRITE_ROTATION_SPEED_AIR * delta)
	#if in the air, quickly straighten out
	else:
		monaSprite.rotation = lerp_angle(monaSprite.rotation, 0, SPRITE_ROTATION_SPEED_AIR * delta)
	
	#determine vertical direction; since physics does not use this value, it does not need to be numerical
	if velocity.y > 0:
		goingUp = false
	else:
		goingUp = true
	
	#given steep terrain, hop up slopes
	if isOnFloor: #if separated anyway, re-replace with function? if not, replace other funcs with this var?
		if abs(velocity.x) > SPEED_THAT_RAMPS:
			var currentSlopeAngle =(rad_to_deg(floorNormal.angle())+90)
			var slopeRight = rad_to_deg(checkSlopeRight.get_collision_normal().angle())
			var slopeLeft = rad_to_deg(checkSlopeLeft.get_collision_normal().angle())
			#print(\"---\")
			#print(\"Current: \" + str(currentSlopeAngle))
			#print(\"L: \" + str(slopeLeft))
			#print(\"R: \" + str(slopeRight))
			if checkSlopeRight.is_colliding():
				if slopeRight > 3 * currentSlopeAngle:
					slopeVelocityAdjustment = SLOPE_MULTIPLIER * abs(slopeRight - currentSlopeAngle)
					#print(\"right\" + str(slopeRight) + \"- current \" + str(currentSlopeAngle))
			elif checkSlopeLeft.is_colliding():
				if slopeLeft > 3 * currentSlopeAngle:	#backwards because negative angles
					slopeVelocityAdjustment = SLOPE_MULTIPLIER * abs(slopeLeft - currentSlopeAngle)
					#print(\"L\")
			else:
				slopeVelocityAdjustment = 0
				#print(currentSlopeAngle)
	
	#determines whether the stop is a hard stop for different behaviors at higher speed
	if Input.is_action_pressed(\"move_Left\") and velocity.x > SPEED_THAT_BRAKES:
		isAbruptStop = true
		#print(\"isAbruptStop\")
	elif Input.is_action_pressed(\"move_Right\") and velocity.x < (SPEED_THAT_BRAKES * -1):
		isAbruptStop = true
		#print(\"isAbruptStop\")
	else:
		isAbruptStop = false
	
	#flip the sprite; Mona continues in the same direction briefly if isAbruptStop
	if not isAbruptStop:
		if direction > 0:
			monaSprite.flip_h = false
		elif direction < 0:
			monaSprite.flip_h = true
	
	#determine where the wall is to set wallJump direction; not based on input because then can cheese the timing to jump into wall
	if checkWallLeft.is_colliding():
		jumpDirectionRight = true
	else:
		jumpDirectionRight = false
	
	#for long and high jumps
	set_jump_boost()
	
	#variable Jump, up to max, and disable jump until hitting the ground with input released (otherwise hops)
	if Input.is_action_pressed(\"jump\") and disableJump == false:
		if not onWall:
			velocity.y += ACCEL_JUMP
			
			#Long Jump
			if Input.is_action_pressed(\"slide\") and Input.is_action_just_pressed(\"jump\"):
				if isOnFloor:
					velocity.x += jumpBoost * direction
					velocity.y += LONG_JUMP_Y_PENALTY
			#High Jump
			elif Input.is_action_pressed(\"dash\"):
				if isOnFloor:
					velocity.y += jumpBoost * -1 #so it goes up
					high_jump_moves_to_zero_x() #applies X penalty to stop sideways momentum gradually on ascent
		#hangs on the wall, but doesnt cancel gravity
		else:
			velocity.y += ACCEL_JUMP * ON_WALL_DRAG
	elif Input.is_action_just_pressed(\"jump\") and disableJump: #wall jump
		if not onWall:
			pass
		else:
			if jumpDirectionRight:
				velocity.x += WALL_JUMP_X
			else:
				velocity.x += WALL_JUMP_X * -1 
			#velocity.x += direction * WALL_JUMP_X * -1 #original Wall Jump X
			velocity.y += WALL_JUMP_Y
			disableHoriz = true
		
	if abs(velocity.y) > MAX_JUMP or Input.is_action_just_released(\"jump\") or checkCeiling.is_colliding():
		disableJump = true
		slideTimer = 0		#safety reset for High and Long Jump multipliers
	if isOnFloor and not Input.is_action_pressed(\"jump\"):
		disableJump = false

	#if still holding jump at the apex, then sustain the jump for a brief moment, scaled with horizontal speed
	if velocity.y > (HANGTIME_WINDOW * -1) and velocity.y < HANGTIME_WINDOW and Input.is_action_pressed(\"jump\") and hangtimeStart == false:
		hangtimeStart = true
		hangtime = 0
	if hangtimeStart == true and Input.is_action_pressed(\"jump\"): #hangtime decays while held
		hangtime = move_toward(hangtime, 1, HANGTIME_SPEED)
		#print(\"hangtime!\")
	else: #let go, reset
		hangtimeStart = false
		hangtime = 1
	
	#play animations
	if isOnFloor:
		smoothingTimer = 0 #for animation smoothing
		if direction == 0:
			if Input.is_action_pressed(\"dash\"):
				monaSprite.play(\"J-Taunt\")
			elif Input.is_action_pressed(\"slide\"):
				monaSprite.play(\"I-Check\")
			else:
				monaSprite.play(\"A-Idle\")
		else: #different run speeds
			if not isAbruptStop: #brake animation has priority over which speed would play
				if isSliding:
					monaSprite.play(\"F-Slide\")
				elif isDashing:
					monaSprite.play(\"H-Dash\")
				else:
					if abs(velocity.x) > SPEED_3:
						monaSprite.play(\"B-Run3\")
					elif abs(velocity.x) > SPEED_2:
						monaSprite.play(\"B-Run2\")
					else:
						monaSprite.play(\"B-Run1\")
			else:
				monaSprite.play(\"E-Brake\")
	else:
		smoothingTimer += 1
		if onWall:
			if checkWallLeft.is_colliding(): #to prevent neutral inputs from playing the wrong wall sprite
				monaSprite.flip_h = true 
				monaSprite.play(\"K-WallJump\")
			else:
				monaSprite.flip_h = false 
				monaSprite.play(\"K-WallJump\")
		else:
			if not goingUp:
				if smoothingTimer > SMOOTHING_RUN_MARGIN:
					if isDiving:
						monaSprite.play(\"G-Dive\")
					else:
						monaSprite.play(\"D-Fall\")
			else:
				monaSprite.play(\"C-Jump\")
	#H-Vault plays as triggered in vault_target.gd
	
	#apply the movement
	if direction:
		if not isOnFloor:
			if not disableHoriz: #for wallJumping
				velocity.x += direction * ACCEL_AIR
		else: #brake/Decel for a abrupt turns
			if isAbruptStop:
				velocity.x = move_toward(velocity.x, 0, DECEL_SLIDE)
				if brakeTimer == END_BRAKING:
					velocity.x = 0
					#print(\"END_BRAKING\")
					brakeTimer = 0
				else:
					brakeTimer += 1
			else:
				brakeTimer = 0 #failsafe inclusion
				if Input.is_action_pressed(\"dash\") or not Input.is_action_pressed(\"slide\"):
					velocity.x += ACCEL_MAIN * direction	#primary, normal x-movement
					velocity.y -= slopeVelocityAdjustment	#for slope boosts
					if not checkCeiling.is_colliding():		#prevents getting stuck under places
						monaCollisionTop.set_deferred(\"disabled\", false)
					else:
						velocity.x += SLIDE_UNDER_BOOST * direction
					isSliding = false						#for animation
					if Input.is_action_pressed(\"dash\") and not dashDisabled:
						velocity.x += direction * DASH_SPEED
						dashDisabled = true
						isDashing = true
				else:
					velocity.x = move_toward(velocity.x, 0, SLIDE_SPEED)
					monaCollisionTop.set_deferred(\"disabled\", true)
					isSliding = true
	#if not moving, slow down
	elif isOnFloor: #dont slow down in the air
		if not checkCeiling.is_colliding(): #wont slow down if would get stuck under an object
			velocity.x = move_toward(velocity.x, 0, DECEL)
		else:
			velocity.x += SLIDE_UNDER_BOOST #if stuck and still
	
	#Mona can exceed maxSpeed via Boosts, but quickly returns to it
	if abs(velocity.x) > SPEED_MAX:
		if direction > 0:
			if dashDisabled:
				velocity.x = move_toward(velocity.x, SPEED_MAX, SLOW_FROM_DASH)
			else:
				velocity.x = move_toward(velocity.x, SPEED_MAX, SLOW_TO_MAX)
		elif direction < 0:
			if dashDisabled:
				velocity.x = move_toward(velocity.x, SPEED_MAX * -1, SLOW_FROM_DASH)
			else:
				velocity.x = move_toward(velocity.x, SPEED_MAX * -1, SLOW_TO_MAX)
	
	#Dash cooldown timer and status; handled here instead of clogging up movement function
	if dashDisabled and dashCooldownTimer == DASH_COOLDOWN_MAX:
		dashDisabled = false
		dashCooldownTimer = 0
		#print(\"Dash Ready!\")
	elif dashDisabled:
		dashCooldownTimer += 1
	if dashTimer == DASH_LENGTH:
		isDashing = false
		dashTimer = 0
	else:
		dashTimer += 1
	
	#WallJump Xinput cooldown timer and status; handled here instead of clogging up movement function
	if disableHoriz and disableHorizTimer == DISABLE_HORIZ_TIMER_MAX:
		disableHoriz = false
		disableHorizTimer = 0
	elif disableHoriz:
		disableHorizTimer += 1
	
	#screen wrap based on direction
	screen_wrap()
	
	#camera motion
	cameraOffsetAccel = abs( (CAMERA_MAX_X_OFFSET/2) - abs(cameraMona.offset.x) ) / CAMERA_X_OFFSET_FACTOR
	cameraXOffsetSpeed = abs(velocity.x / CAMERA_X_OFFSET_FACTOR) * cameraOffsetAccel
	#if Mona jumps, eliminate lag: for easier short platforming
	if Input.is_action_just_pressed(\"jump\"):
		cameraLagTimer = CAMERA_LAG_MAX
		cameraZoom += CAMERA_ZOOM_OUT
	#as Mona moves, pull forward and out
	if direction:
		if cameraLagTimer >= CAMERA_LAG_MAX:
			cameraMona.offset.x = move_toward(cameraMona.offset.x, CAMERA_MAX_X_OFFSET * direction, cameraXOffsetSpeed)
			cameraZoom += CAMERA_ZOOM_OUT
			cameraMona.zoom = Vector2(cameraZoom, cameraZoom)
		else:
			cameraLagTimer += 1
	else:
		if cameraLagTimer <= 0:
			cameraLagTimer = 0
		else:
			cameraLagTimer += CAMERA_LAG_DECREASE
		cameraMona.offset.x = move_toward(cameraMona.offset.x, 0, CAMERA_RESET_SPEED)
		if cameraZoomTimer == CAMERA_ZOOM_TIME:
			cameraZoom += CAMERA_ZOOM_IN
			cameraMona.zoom = Vector2(cameraZoom, cameraZoom)
		else:
			cameraZoomTimer += 1
	#cap the camera zoom
	if cameraZoom < CAMERA_MAX_ZOOM_OUT:
		cameraZoom = CAMERA_MAX_ZOOM_OUT
		cameraZoomTimer = 0
	elif cameraZoom > CAMERA_MAX_ZOOM_IN:
		cameraZoom = CAMERA_MAX_ZOOM_IN
		cameraZoomTimer = 0
	
	#snap to floor unless jumping
	if not goingUp:
		apply_floor_snap()
	
	move_and_slide()

#functions called to wrap Mona in the level, at the safe zone where stuff doesn't move around...
func screen_wrap():
	cameraMona.limit_smoothed = false #disable camera actions for a more seamless snap
	cameraMona.position_smoothing_enabled = false
	
	position.x = wrapf(position.x,wrapLeftSeam.position.x,wrapRightSeam.position.x) #move Mona b/w boundaries
	#cameraMona.position.x = wrapf(cameraMona.position.x,wrapLeftSeam.position.x,wrapRightSeam.position.x)
	
	cameraMona.limit_smoothed = true #re-enable camera smoothing
	cameraMona.position_smoothing_enabled = true

#used to determine the boost to the long and high jumps
func set_jump_boost():
	#length of time into boost: quickly ramp > max sweetspot > lower boost during slow down
	if isSliding or isDashing or dashDisabled:
		slideTimer += 1
		if slideTimer < PERFECT_JUMP_MIN:
			jumpBoost = slideTimer * BOOST_RATE_EARLY
		elif slideTimer <= PERFECT_JUMP_MAX:
			jumpBoost = MAX_JUMP_BOOST
		else:
			jumpBoost -= BOOST_RATE_DECLINE
	else:
		slideTimer = 0
	
		#caps the boost
	if jumpBoost > MAX_JUMP_BOOST:
		jumpBoost = MAX_JUMP_BOOST
	elif jumpBoost < 0:
		jumpBoost = 0
		
	#print(jumpBoost)
	
	#too slow = no boost
	if abs(velocity.x) < MIN_SPEED_FOR_LONG_JUMP:
		jumpBoost = 0
	
	#comes after capping the max, so the high jump is functionally capped lower, too
	if ( not isSliding ) and ( isDashing or dashDisabled ):
		jumpBoost *= HIGH_JUMP_FRACTION

#used to determine the boost to the long and high jumps
#v1  -  currently not called, kept as backup
func set_jump_boost_DEPRECATED():
	#checks for High Jump to halve the boost
	var isHighJump = false
	
	#Long Jump
	if isSliding:
		if slideTimer >= PERFECT_JUMP_MIN and slideTimer <= PERFECT_JUMP_MAX:
			print(\"window\")
		else:
			print(\"--\")
		slideTimer += 1
	#High Jump peaks right before dash comes Online again: needs a visual cue
	elif isDashing or dashDisabled:
		slideTimer += HIGH_JUMP_BOOST
		isHighJump = true
	else:
		slideTimer = 0
	
	#longer the slide, farther the boost
	jumpBoost = slideTimer * JUMP_BOOST_FACTOR
	
	#caps the boost max and disables the boost if held until a near-stop
	if jumpBoost > MAX_JUMP_BOOST:
		jumpBoost = MAX_JUMP_BOOST
	if abs(velocity.x) < MIN_SPEED_FOR_LONG_JUMP:
		jumpBoost = 0
		
	#comes after capping the max, so the high jump is functionally capped lower, too
	if isHighJump:
		jumpBoost *= HIGH_JUMP_FRACTION

func high_jump_moves_to_zero_x():
	var breakTimer = 0
	while abs(velocity.x) > 0:
		velocity.x = move_toward(velocity.x, 0, jumpBoost / HIGH_JUMP_X_PENALTY)
		breakTimer += 1
		if breakTimer == 100:
			break
	
	#older drafts of func set_jump_boost
	#v1
	#jumpBoost = (abs(velocity.x) / SPEED_MAX) * MAX_JUMP_BOOST
	#v2
	#if abs(velocity.x) != 0:
	#	jumpBoost = (SPEED_MAX / abs(velocity.x) ) * MAX_JUMP_BOOST
	#else:
	#	jumpBoost = MAX_JUMP_BOOST
"

